{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "client/build" }
    },
    {
      "src": "server/**",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/.vercel/functions/api/:splat"
    },
    {
      "src": "/(.*)",
      "dest": "client/_next/static/:splat"
    },
    {
      "src": "/*",
      "dest": "client/_next/static/:splat"
    }
  ]
}